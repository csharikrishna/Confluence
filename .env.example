# Environmental Intelligence Unified API - Environment Configuration

# OpenAQ API Key (Free tier key from https://openaq.org/)
OPENAQ_API_KEY=your_openaq_api_key_here

# NVIDIA NIM API Key (Optional, for frontier model grounding tests)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Server Port
PORT=8000

# --- Phase 2 (optional) ---

# Where the SQLite history store lives. Defaults to confluence_history.db next
# to app.py. Point this at a mounted persistent disk path in production
# (e.g. /var/data/confluence_history.db) — see README "Phase 2" section.
CONFLUENCE_DB_PATH=confluence_history.db

# Slack or Discord incoming-webhook URL. When set, newly-triggered alerts from
# /environment and /alerts are pushed there in addition to the API response.
# Leave unset to disable (default) — nothing else in the app requires this.
ALERT_WEBHOOK_URL=

# --- Optional: durable storage backend (instead of the default SQLite file) ---
# Leave STORAGE_BACKEND unset/"sqlite" to keep using storage.py (default, no
# setup required — fine until you need history to survive a Render redeploy).
#
# STORAGE_BACKEND=mongo (RECOMMENDED): MongoDB Atlas free tier (M0) — fully
# managed, no server to run, no credit card to sign up. Requires:
# pip install -r requirements-mongo.txt, then a connection string from
# https://cloud.mongodb.com (Database > Connect > Drivers).
STORAGE_BACKEND=sqlite
MONGODB_URI=
MONGODB_DB_NAME=confluence

# A CouchDB backend (STORAGE_BACKEND=couchdb) was built and verified against a
# real instance, then archived to the `archive/couchdb-backend` git branch —
# Mongo above covers everything it would have, so it's no longer wired into
# db_backend.py on main. `git checkout archive/couchdb-backend` to retrieve it.

# --- Optional: daily Google Drive backup (disaster-recovery copy only) ---
# Requires: pip install -r requirements-gdrive.txt, plus a Google Cloud service
# account with access to a Drive folder (share the folder with its email).
GDRIVE_ENABLED=false
GDRIVE_FOLDER_ID=
# Use ONE of the next two — the raw JSON key content (works on hosts with no
# persistent file storage, e.g. Render) or a path to the key file.
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_SERVICE_ACCOUNT_FILE=
